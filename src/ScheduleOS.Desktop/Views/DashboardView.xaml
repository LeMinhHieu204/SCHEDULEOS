<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:ScheduleOS.Desktop.ViewModels.Pages"
                    xmlns:ctl="clr-namespace:ScheduleOS.Desktop.Controls"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <Style x:Key="CardHeaderIcon" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <DataTemplate DataType="{x:Type p:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DashboardPage" Focusable="False">
            <Grid Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.95*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <!-- Header -->
                <DockPanel Grid.ColumnSpan="4" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.DangerSoft}" Margin="0,0,12,0" VerticalAlignment="Center" Command="{Binding CheckConflictsCommand}"
                            Visibility="{Binding ConflictsDetected, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="ConflictsBanner"
                            ToolTip="Upcoming bookings that no longer satisfy staff hours, leave, rooms or maintenance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"><Run Text="{Binding ConflictsDetected, Mode=OneWay}" /><Run Text=" conflicts detected" /></TextBlock>
                        </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Card.Flat}" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Brush.Text}" Margin="2,0,12,0" />
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" MinWidth="112" AutomationProperties.AutomationId="DashboardDate" />
                            <Button Style="{StaticResource Button.IconOutline}" Content="&#xE76B;" Margin="10,0,4,0" Command="{Binding PreviousDayCommand}" ToolTip="Previous day" Width="30" Height="30" />
                            <Button Style="{StaticResource Button.IconOutline}" Content="&#xE76C;" Command="{Binding NextDayCommand}" ToolTip="Next day" Width="30" Height="30" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Today" Margin="8,0,0,0" MinHeight="30" Command="{Binding TodayCommand}" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.H1}" AutomationProperties.AutomationId="Greeting" />
                        <TextBlock Text="Here's what's happening with your business today." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- KPI cards -->
                <ItemsControl Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Kpis}" Margin="-8,0,-8,16" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{Binding IconBgKey, Converter={StaticResource ResBrush}}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" Foreground="{Binding IconBrushKey, Converter={StaticResource ResBrush}}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Strong}" FontSize="13" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                            <TextBlock Style="{StaticResource Text.Kpi}" AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Value}">
                                                <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="{Binding Suffix, Mode=OneWay}" FontSize="20" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Delta}" Foreground="{Binding DeltaBrushKey, Converter={StaticResource ResBrush}}" FontWeight="SemiBold" FontSize="12.5"
                                                       VerticalAlignment="Center" Margin="10,6,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Weekly revenue -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,16,16" Height="330" AutomationProperties.AutomationId="WeeklyRevenueCard"
                        Visibility="{Binding ShowRevenue, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding WeekTotal}" Style="{StaticResource Text.H2}" FontSize="20" />
                                    <TextBlock Text="{Binding WeekChange, Converter={StaticResource Change}}" Foreground="{Binding WeekChange, Converter={StaticResource Change}, ConverterParameter=brush}"
                                               FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="8,2,0,0" />
                                </StackPanel>
                                <TextBlock Text="vs. previous week" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Border Style="{StaticResource CardHeaderIcon}">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Weekly Revenue" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="{Binding WeekRange}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ctl:BarChart Points="{Binding WeeklyRevenue}" AxisFormat="money" EmptyText="No payments recorded this week" AutomationProperties.AutomationId="WeeklyRevenueChart" />
                    </DockPanel>
                </Border>

                <!-- Appointment status -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,16,16" Height="330" AutomationProperties.AutomationId="StatusCard">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource CardHeaderIcon}">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" />
                            </Border>
                            <TextBlock Text="Appointment Status" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ctl:DonutChart Slices="{Binding StatusSlices}" CenterValue="{Binding StatusTotal}" CenterLabel="Appointments today" Thickness="22" MaxWidth="170" MaxHeight="170" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusLegend}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,10,3">
                                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Display}" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Today's schedule -->
                <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,16,10,12" AutomationProperties.AutomationId="TodaysScheduleCard">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,6,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Command="{Binding ViewCalendarCommand}" Content="View Calendar →" />
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,10,0" />
                            <TextBlock Text="Today's Schedule" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="No appointments scheduled." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="{Binding TodaysSchedule.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="660" Focusable="False">
                                <ItemsControl ItemsSource="{Binding TodaysSchedule}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,4,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Start, Converter={StaticResource Date}, ConverterParameter=h:mm tt}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                                                <Rectangle Grid.Column="1" Width="1.5" Fill="{DynamicResource Brush.Border}" HorizontalAlignment="Center" />
                                                <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="0,12,0,0" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Padding="0" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                        Command="{Binding DataContext.OpenAppointmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding CustomerName}">
                                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="9" Padding="11,8" Background="{DynamicResource Brush.Surface}">
                                                        <DockPanel>
                                                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" VerticalAlignment="Top" Margin="6,0,0,0" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Text.Strong}" FontSize="12.5" />
                                                                <TextBlock Text="{Binding Services}" Style="{StaticResource Text.Caption}" />
                                                                <TextBlock Text="{Binding Staff}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Upcoming -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,16" MinHeight="360" Padding="16,16,12,12" AutomationProperties.AutomationId="UpcomingCard">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,4,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="View All →" Command="{Binding ViewAppointmentsCommand}" />
                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,10,0" />
                            <TextBlock Text="Upcoming Appointments" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="No upcoming appointments." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding Upcoming.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" Width="64">
                                                    <TextBlock Text="{Binding Item.Start, Converter={StaticResource Date}, ConverterParameter=h:mm tt}" Style="{StaticResource Text.Strong}" FontSize="12" />
                                                    <TextBlock Text="{Binding Item.Start, Converter={StaticResource Date}, ConverterParameter=ddd MMM d}" Style="{StaticResource Text.Caption}" />
                                                </StackPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE712;" Width="28" Height="28" ToolTip="Actions" AutomationProperties.Name="Actions"
                                                        core:MenuButton.OpenOnClick="True">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.OpenUpcomingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Confirm" IsEnabled="{Binding CanConfirm}" Command="{Binding PlacementTarget.Tag.ConfirmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Reschedule…" IsEnabled="{Binding CanReschedule}" Command="{Binding PlacementTarget.Tag.RescheduleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Cancel…" IsEnabled="{Binding CanCancel}" Command="{Binding PlacementTarget.Tag.CancelAppointmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Tag>
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </Button.Tag>
                                                </Button>
                                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding Item.Status}" ContentTemplate="{StaticResource StatusPill}" Margin="6,0" />
                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding Item.CustomerName}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Item.CustomerName}" Style="{StaticResource Text.Strong}" FontSize="12.5" />
                                                    <TextBlock Text="{Binding Item.Services}" Style="{StaticResource Text.Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Top staff -->
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,16" Padding="16" AutomationProperties.AutomationId="TopStaffCard">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <TextBlock Text="This week" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,10,0" />
                            <TextBlock Text="Top Staff Performance" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="Auto" MinWidth="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="1" Text="STAFF" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="2" Text="DONE" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="REVENUE" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="No completed services this week yet." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding TopStaff.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding TopStaff}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0,1,0,0" Padding="2,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="Auto" MinWidth="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Staff.ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=light}">
                                                        <TextBlock Text="{Binding Staff.Initials}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Staff.ColorHex, Converter={StaticResource HexBrush}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Staff.Name}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="120" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Staff.Completed}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Staff.ServiceRevenueMinor, Converter={StaticResource Money}}" Style="{StaticResource Text.Strong}" FontSize="12.5"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Customer activity -->
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,16,16" Padding="16" AutomationProperties.AutomationId="ActivityCard"
                        Visibility="{Binding CanViewCustomers, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="View All →" Command="{Binding ViewCustomersCommand}" />
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,10,0" />
                            <TextBlock Text="Recent Customer Activity" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="Activity appears here as bookings, payments and visits are recorded." Style="{StaticResource Text.SecondaryWrap}" TextAlignment="Center" Margin="10,30,10,0"
                                       Visibility="{Binding Activity.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Ghost}" Padding="4,7" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                Command="{Binding DataContext.OpenActivityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding Item.CustomerName}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Item.CustomerName}" Style="{StaticResource Text.Strong}" FontSize="12.5" />
                                                    <TextBlock Text="{Binding Item.Title}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
                                                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
