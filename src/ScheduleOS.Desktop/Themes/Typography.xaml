<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Spacing / shape tokens -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Pad.Card">20,18,20,18</Thickness>
    <Thickness x:Key="Pad.Page">28,22,28,24</Thickness>
    <sys:Double x:Key="Size.ControlHeight">36</sys:Double>
    <sys:Double x:Key="Size.RowHeight">46</sys:Double>
    <sys:Double x:Key="Size.SidebarWidth">212</sys:Double>

    <!-- Icon glyphs (Segoe Fluent Icons / MDL2) -->
    <sys:String x:Key="Icon.Dashboard">&#xE80F;</sys:String>
    <sys:String x:Key="Icon.Calendar">&#xE787;</sys:String>
    <sys:String x:Key="Icon.Appointments">&#xE9D5;</sys:String>
    <sys:String x:Key="Icon.Customers">&#xE716;</sys:String>
    <sys:String x:Key="Icon.Staff">&#xE77B;</sys:String>
    <sys:String x:Key="Icon.Services">&#xE8EC;</sys:String>
    <sys:String x:Key="Icon.Resources">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Payments">&#xE8C7;</sys:String>
    <sys:String x:Key="Icon.Analytics">&#xE9D2;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Bell">&#xEA8F;</sys:String>
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.ChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.Back">&#xE72B;</sys:String>
    <sys:String x:Key="Icon.Forward">&#xE72A;</sys:String>
    <sys:String x:Key="Icon.Mail">&#xE715;</sys:String>
    <sys:String x:Key="Icon.Phone">&#xE717;</sys:String>
    <sys:String x:Key="Icon.Location">&#xE707;</sys:String>
    <sys:String x:Key="Icon.Print">&#xE749;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Clock">&#xE823;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xE783;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Completed">&#xE930;</sys:String>
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Icon.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Icon.SignOut">&#xE7E8;</sys:String>
    <sys:String x:Key="Icon.History">&#xE81C;</sys:String>
    <sys:String x:Key="Icon.Flag">&#xE7C1;</sys:String>
    <sys:String x:Key="Icon.Message">&#xE8BD;</sys:String>
    <sys:String x:Key="Icon.List">&#xE8FD;</sys:String>
    <sys:String x:Key="Icon.Filter">&#xE71C;</sys:String>
    <sys:String x:Key="Icon.Download">&#xE896;</sys:String>
    <sys:String x:Key="Icon.Upload">&#xE898;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.Document">&#xE8A5;</sys:String>
    <sys:String x:Key="Icon.Money">&#xE825;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Star">&#xE734;</sys:String>
    <sys:String x:Key="Icon.Repair">&#xE90F;</sys:String>
    <sys:String x:Key="Icon.Play">&#xE768;</sys:String>
    <sys:String x:Key="Icon.Person">&#xE77B;</sys:String>
    <sys:String x:Key="Icon.AddPerson">&#xE8FA;</sys:String>
    <sys:String x:Key="Icon.Menu">&#xE700;</sys:String>
    <sys:String x:Key="Icon.More">&#xE712;</sys:String>
    <sys:String x:Key="Icon.Lightning">&#xE945;</sys:String>
    <sys:String x:Key="Icon.Duplicate">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Undo">&#xE7A7;</sys:String>
    <sys:String x:Key="Icon.Database">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Palette">&#xE790;</sys:String>
    <sys:String x:Key="Icon.Key">&#xE8D7;</sys:String>
    <sys:String x:Key="Icon.Minimize">&#xE921;</sys:String>
    <sys:String x:Key="Icon.Maximize">&#xE922;</sys:String>
    <sys:String x:Key="Icon.Restore">&#xE923;</sys:String>
    <sys:String x:Key="Icon.ChromeClose">&#xE8BB;</sys:String>

    <!-- Text styles -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />
    <Style x:Key="Text.Strong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Kpi" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Text.Wrap" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="Text.SecondaryWrap" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
</ResourceDictionary>
