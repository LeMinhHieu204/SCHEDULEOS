<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ScheduleOS brand palette (optional dark workspace) -->
    <Color x:Key="Color.Navy">#102532</Color>
    <Color x:Key="Color.SidebarDark">#0A1A24</Color>
    <Color x:Key="Color.Primary">#00A3AC</Color>
    <Color x:Key="Color.PrimaryBright">#00C4C9</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#0B1C26" Offset="0" />
        <GradientStop Color="#091821" Offset="0.55" />
        <GradientStop Color="#0A2229" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#D3DEE5" />
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#7F97A5" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#16FFFFFF" />
    <LinearGradientBrush x:Key="Brush.SidebarSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B6E76" Offset="0" />
        <GradientStop Color="#0A4E58" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="#1A3341" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#112734" />

    <SolidColorBrush x:Key="Brush.Workspace" Color="#0E1A22" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#15232D" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#192A35" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1D303C" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E5EDF2" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9AAFBD" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E8494" />
    <SolidColorBrush x:Key="Brush.Border" Color="#243846" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#30495A" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#112029" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="#1C2E3A" />
    <SolidColorBrush x:Key="Brush.GridLineHour" Color="#243846" />

    <SolidColorBrush x:Key="Brush.Primary" Color="#00A3AC" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#00B3BB" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="#008C95" />
    <SolidColorBrush x:Key="Brush.PrimaryBright" Color="#00C4C9" />
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="#123A3E" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#11303A" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00A8B0" Offset="0" />
        <GradientStop Color="#008790" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Success" Color="#2BC197" />
    <SolidColorBrush x:Key="Brush.SuccessLight" Color="#123B32" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F0B355" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#F0B355" />
    <SolidColorBrush x:Key="Brush.WarningLight" Color="#3A2E17" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F06A75" />
    <SolidColorBrush x:Key="Brush.DangerLight" Color="#3D1F25" />
    <SolidColorBrush x:Key="Brush.Info" Color="#5AA2F0" />
    <SolidColorBrush x:Key="Brush.InfoLight" Color="#172E46" />
    <SolidColorBrush x:Key="Brush.Purple" Color="#A685FA" />
    <SolidColorBrush x:Key="Brush.PurpleLight" Color="#2A2346" />
    <SolidColorBrush x:Key="Brush.Neutral" Color="#8EA0AD" />
    <SolidColorBrush x:Key="Brush.NeutralLight" Color="#22313B" />
    <SolidColorBrush x:Key="Brush.NotesWarm" Color="#2E2818" />

    <SolidColorBrush x:Key="Brush.ChartBar" Color="#1E5559" />
    <SolidColorBrush x:Key="Brush.ChartBarStrong" Color="#00A3AC" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#99050C11" />
    <SolidColorBrush x:Key="Brush.Tooltip" Color="#E5EDF2" />
    <SolidColorBrush x:Key="Brush.TooltipText" Color="#14253D" />
    <SolidColorBrush x:Key="Brush.Today" Color="#00A3AC" />

    <DrawingBrush x:Key="Brush.Hatch" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#13212A" Geometry="M0,0 L8,0 8,8 0,8Z" />
                <GeometryDrawing Geometry="M0,8 L8,0">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#22343F" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Brush.HatchDanger" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2A1A1F" Geometry="M0,0 L8,0 8,8 0,8Z" />
                <GeometryDrawing Geometry="M0,8 L8,0">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#4A2A31" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
