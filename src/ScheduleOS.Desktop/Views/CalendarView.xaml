<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:ScheduleOS.Desktop.ViewModels.Pages"
                    xmlns:ctl="clr-namespace:ScheduleOS.Desktop.Controls"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <Style x:Key="FilterBox" TargetType="Border" BasedOn="{StaticResource Card.Flat}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <DataTemplate DataType="{x:Type p:CalendarViewModel}">
        <Grid Margin="{StaticResource Pad.Page}" AutomationProperties.AutomationId="CalendarPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="292" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Success}" Height="44" Padding="20,0" Command="{Binding NewAppointmentCommand}"
                        Visibility="{Binding CanCreate, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="CalendarNewAppointment">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="New Appointment" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Smart Calendar" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Manage your schedule, staff and resources with intelligent scheduling." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14" Orientation="Horizontal">
                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding Shell.Locations}" SelectedItem="{Binding Shell.SelectedLocation}" Margin="0,0,10,8"
                          ToolTip="Location" AutomationProperties.AutomationId="CalLocation" AutomationProperties.Name="Location filter" />
                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding StaffFilter}" SelectedItem="{Binding SelectedStaff}" Margin="0,0,10,8" DisplayMemberPath="Name"
                          ToolTip="Staff" AutomationProperties.AutomationId="CalStaff" AutomationProperties.Name="Staff filter" />
                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding CategoryFilter}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,14,8" DisplayMemberPath="Name"
                          ToolTip="Service category" AutomationProperties.AutomationId="CalServices" AutomationProperties.Name="Service filter" />
                <Border Style="{StaticResource Card.Flat}" Padding="4" Margin="0,0,10,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Command="{Binding PreviousCommand}" ToolTip="Previous" AutomationProperties.AutomationId="CalPrev" AutomationProperties.Name="Previous" />
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" MinWidth="170" TextAlignment="Center" Margin="6,0"
                                   AutomationProperties.AutomationId="CalRange" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="Next" AutomationProperties.AutomationId="CalNext" AutomationProperties.Name="Next" />
                    </StackPanel>
                </Border>
                <Button Content="Today" Style="{StaticResource Button.Secondary}" Margin="0,0,10,8" MinHeight="42" Command="{Binding TodayCommand}" AutomationProperties.AutomationId="CalToday" />
                <DatePicker SelectedDate="{Binding Date}" Width="130" Margin="0,0,14,8" MinHeight="42" ToolTip="Jump to date" AutomationProperties.AutomationId="CalJump" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Day" GroupName="CalView" AutomationProperties.AutomationId="ViewDay"
                                     IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Day}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Week" GroupName="CalView" AutomationProperties.AutomationId="ViewWeek"
                                     IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Week}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Month" GroupName="CalView" AutomationProperties.AutomationId="ViewMonth"
                                     IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                        <RadioButton Style="{StaticResource Segment}" Content="List" GroupName="CalView" AutomationProperties.AutomationId="ViewList"
                                     IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=List}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,8" Visibility="{Binding IsDayView, Converter={StaticResource VisibleWhen}}" ToolTip="Group the day view by staff, room or date">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Staff" GroupName="CalGroup" AutomationProperties.AutomationId="GroupStaff"
                                     IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Staff}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Rooms" GroupName="CalGroup" AutomationProperties.AutomationId="GroupRoom"
                                     IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Room}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Single" GroupName="CalGroup" AutomationProperties.AutomationId="GroupDate"
                                     IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Date}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Secondary}" MinHeight="42" Margin="0,0,10,8" Command="{Binding CheckConflictsCommand}" AutomationProperties.AutomationId="ConflictCheck">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Conflict Check" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Primary}" />
                    </StackPanel>
                </Button>
                <CheckBox Content="Show cancelled" IsChecked="{Binding IncludeCancelled}" VerticalAlignment="Center" Margin="4,0,0,8" Style="{StaticResource Toggle}" />
            </WrapPanel>

            <!-- Main board -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0" ClipToBounds="True">
                <Grid>
                    <ctl:ScheduleBoard Model="{Binding Board}" SlotCommand="{Binding SlotCommand}" OpenCommand="{Binding OpenCommand}" MoveCommand="{Binding MoveCommand}"
                                       ActionCommand="{Binding ActionCommand}" PreviewProvider="{Binding PreviewProvider}" Margin="0,6,0,0"
                                       Visibility="{Binding IsBoardView, Converter={StaticResource VisibleWhen}}" />

                    <!-- Month -->
                    <DockPanel Visibility="{Binding IsMonthView, Converter={StaticResource VisibleWhen}}" Margin="12">
                        <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,6">
                            <TextBlock Text="Mon" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Tue" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Wed" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Thu" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Fri" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Sat" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                            <TextBlock Text="Sun" Style="{StaticResource Text.Overline}" TextAlignment="Center" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding MonthCells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0.5" Padding="6,4" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InMonth}" Value="False"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource Button.Link}" Content="{Binding Day}" FontSize="12.5"
                                                    Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Foreground="{DynamicResource Brush.Text}" ToolTip="Open day view" />
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" Style="{StaticResource Text.Caption}" />
                                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Button.Ghost}" Padding="0" MinHeight="0" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}">
                                                            <Border CornerRadius="4" Padding="5,1" Margin="0,1" Background="{Binding Color, Converter={StaticResource HexBrush}, ConverterParameter=light}">
                                                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- List -->
                    <DataGrid ItemsSource="{Binding ListItems}" Visibility="{Binding IsListView, Converter={StaticResource VisibleWhen}}" Margin="8"
                              core:ItemActivation.Command="{Binding OpenListItemCommand}" AutomationProperties.AutomationId="CalendarList">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Start, StringFormat={}{0:ddd MMM d}}" Width="110" />
                            <DataGridTextColumn Header="TIME" Binding="{Binding Start, StringFormat={}{0:h:mm tt}}" Width="80" />
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="1.2*" />
                            <DataGridTextColumn Header="SERVICES" Binding="{Binding Services}" Width="1.5*" />
                            <DataGridTextColumn Header="STAFF" Binding="{Binding Staff}" Width="*" />
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" IsHitTestVisible="False" Visibility="{Binding EmptyMessage, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Secondary}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Side panel -->
            <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <!-- Mini calendar -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE76C;" Width="28" Height="28" Command="{Binding MiniNextCommand}" AutomationProperties.Name="Next month" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE76B;" Width="28" Height="28" Command="{Binding MiniPreviousCommand}" AutomationProperties.Name="Previous month" />
                                <TextBlock Text="{Binding MiniMonthText}" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                            </DockPanel>
                            <UniformGrid Columns="7">
                                <TextBlock Text="Mo" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="Tu" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="We" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="Th" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="Fr" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="Sa" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                                <TextBlock Text="Su" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding MiniDays}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Width="32" Height="30" MinHeight="0" Padding="0" Margin="1" FontWeight="Normal" FontSize="12" Content="{Binding Day}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Today's overview -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14" Visibility="{Binding Overview.Count, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Today's Overview" Style="{StaticResource Text.H3}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Overview}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,5">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Background="{Binding IconBgKey, Converter={StaticResource ResBrush}}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{Binding IconBrushKey, Converter={StaticResource ResBrush}}" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Delta}" Foreground="{Binding DeltaBrushKey, Converter={StaticResource ResBrush}}" FontWeight="SemiBold"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.H2}" />
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,5,0,0">
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Background="{DynamicResource Brush.DangerLight}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Danger}" />
                                </Border>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="View ›" Command="{Binding CheckConflictsCommand}" Foreground="{DynamicResource Brush.Danger}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource Text.H2}" AutomationProperties.AutomationId="ConflictCount" />
                                    <TextBlock Text="Conflicts Detected (next 14 days)" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rooms -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Room &amp; Resource Availability" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                            <TextBlock Text="No rooms or resources yet." Style="{StaticResource Text.Secondary}" Visibility="{Binding RoomStatus.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding RoomStatus}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4" ToolTip="{Binding NextBooking}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource ResourceStateBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}" Width="74" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12.5" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Quick actions -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" Style="{StaticResource Text.H3}" Margin="0,0,0,10" />
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource Button.Secondary}" Margin="0,0,5,0" Height="52" Command="{Binding FindTimeCommand}" AutomationProperties.AutomationId="FindTime">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Find Time" VerticalAlignment="Center" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Secondary}" Margin="5,0,0,0" Height="52" Command="{Binding CheckConflictsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Check Conflicts" VerticalAlignment="Center" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,12,0,0"
                                       Text="Tip: drag an appointment to move it, drag its bottom edge to change its length, or select it and press Ctrl+↑/↓ (time), Ctrl+←/→ (column), Ctrl+Shift+↑/↓ (length). Click an empty slot to book." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
