                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Full" Margin="6,0,0,0" Command="{Binding PayFullCommand}" />
                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PayAmount" />
                        </DockPanel>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="External reference (terminal / transfer ID)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Note" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </UniformGrid>
                <Border Background="{DynamicResource Brush.InfoLight}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                    <TextBlock Text="{Binding CardNotice}" Style="{StaticResource Text.Wrap}" FontSize="12" Foreground="{DynamicResource Brush.Info}" />
                </Border>
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Record payment" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="PaySave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

