<UserControl x:Class="ScheduleOS.Desktop.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Sidebar">
    <Border Background="{DynamicResource Brush.Sidebar}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="{StaticResource Size.SidebarWidth}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                        <Setter Property="Width" Value="76" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <!-- Brand -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,22">
                <Image Source="pack://application:,,,/ScheduleOS;component/Assets/logo-256.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarCollapsed, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="Bold" Foreground="White">
                        <Run Text="Schedule" /><Run Text="OS" Foreground="{DynamicResource Brush.PrimaryBright}" />
                    </TextBlock>
                    <TextBlock Text="Smart Appointment Manager" FontSize="10.5" Foreground="{DynamicResource Brush.SidebarTextMuted}" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                <Border Background="{DynamicResource Brush.SidebarCard}" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12"
                        Visibility="{Binding SidebarCollapsed, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE825;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Warning}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusinessName}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedLocation.Name}" Foreground="{DynamicResource Brush.SidebarTextMuted}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <Border Background="#33E7A23A" CornerRadius="6" Padding="8,3" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsDemoWorkspace, Converter={StaticResource VisibleWhen}}" ToolTip="This workspace contains fictional demo data">
                            <TextBlock Text="DEMO WORKSPACE" Foreground="#F5C26B" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Border>
                <Button Margin="0,10,0,0" Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Brush.SidebarTextMuted}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse or expand the sidebar"
                        AutomationProperties.Name="Toggle sidebar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource Font.Icons}" FontSize="14" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Collapse" FontWeight="Normal" VerticalAlignment="Center" Visibility="{Binding SidebarCollapsed, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Navigation -->
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Margin="12,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Navigation" AutomationProperties.Name="Navigation">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="17" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
