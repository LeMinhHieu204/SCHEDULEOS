<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:ScheduleOS.Desktop.ViewModels.Pages"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <!-- =================================================================== Customers -->
    <DataTemplate DataType="{x:Type p:CustomersViewModel}">
        <DockPanel Margin="{StaticResource Pad.Page}" AutomationProperties.AutomationId="CustomersPage">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" Command="{Binding ImportCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}"
                            ToolTip="Import a CSV with columns Name, Phone, Email, Notes, Tags (tags separated by ;)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Import CSV" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" Command="{Binding ExportCommand}" Visibility="{Binding CanSeeContact, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Export CSV" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Success}" Command="{Binding NewCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="CustomersNew">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FA;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Add Customer" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Customers" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Profiles, visit history, spending and segments." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search name, phone or e-mail…" Width="300" Margin="0,0,10,8" AutomationProperties.AutomationId="CustomerSearch" />
                <ComboBox ItemsSource="{Binding Segments}" SelectedItem="{Binding Segment}" Width="190" Margin="0,0,10,8" AutomationProperties.AutomationId="CustomerSegment" />
                <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding Tag}" Width="160" Margin="0,0,10,8" />
                <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Width="140" Margin="0,0,14,8">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}, StringFormat=Sort: {0}}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Include archived" IsChecked="{Binding IncludeArchived}" Style="{StaticResource Toggle}" VerticalAlignment="Center" Margin="0,0,0,8" />
            </WrapPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" customers" /></TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.IconOutline}" Content="&#xE76B;" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous page" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0" Style="{StaticResource Text.Secondary}"><Run Text="Page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource Button.IconOutline}" Content="&#xE76C;" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next page" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" core:ItemActivation.Command="{Binding OpenCommand}" AutomationProperties.AutomationId="CustomersGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUSTOMER" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding FullName}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" Style="{StaticResource Text.Strong}" />
                                                <TextBlock Text="Archived" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding IsArchived, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="*" />
                            <DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="1.4*" />
                            <DataGridTemplateColumn Header="SEGMENTS" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Badge}" Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource BadgeText}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="VISITS" Binding="{Binding CompletedVisits}" Width="70" />
                            <DataGridTextColumn Header="LAST VISIT" Binding="{Binding LastVisit, StringFormat={}{0:MMM d, yyyy}, TargetNullValue=—}" Width="110" />
                            <DataGridTextColumn Header="UPCOMING" Binding="{Binding Upcoming}" Width="90" />
                            <DataGridTextColumn Header="TOTAL PAID" Binding="{Binding TotalPaidMinor, Converter={StaticResource Money}}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No customers match. Add your first customer with Add Customer." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- =================================================================== Customer detail -->
    <DataTemplate DataType="{x:Type p:CustomerDetailViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" AutomationProperties.AutomationId="CustomerDetailPage">
            <Grid Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Button.Success}" Margin="6,0,0,6" Command="{Binding BookCommand}" Visibility="{Binding CanBook, Converter={StaticResource VisibleWhen}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Book Appointment" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Margin="6,0,0,6" Content="Edit" Command="{Binding EditCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource Button.Secondary}" Margin="6,0,0,6" Content="Archive / Restore" Command="{Binding ToggleArchiveCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource Button.Secondary}" Margin="6,0,0,6" Content="Export Data" Command="{Binding ExportDataCommand}" Visibility="{Binding CanExport, Converter={StaticResource VisibleWhen}}"
                                ToolTip="Export this customer's personal data (JSON) for a data-access request" />
                        <Button Style="{StaticResource Button.DangerSoft}" Margin="6,0,0,6" Content="Anonymise" Command="{Binding AnonymizeCommand}" Visibility="{Binding CanAnonymize, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource Button.DangerSoft}" Margin="6,0,0,6" Content="Delete" Command="{Binding DeleteCommand}" Visibility="{Binding CanAnonymize, Converter={StaticResource VisibleWhen}}"
                                ToolTip="Only possible for customers without any history" />
                    </WrapPanel>
                    <StackPanel>
                        <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="← Customers" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Detail.Profile.FullName}" Style="{StaticResource Text.H1}" AutomationProperties.AutomationId="CustomerName" />
                        <TextBlock Text="{Binding UpcomingText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Profile -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Left" Background="{Binding Detail.Profile.FullName, Converter={StaticResource NameBrush}, ConverterParameter=light}">
                                <TextBlock Text="{Binding Detail.Initials}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Detail.Profile.FullName, Converter={StaticResource NameBrush}}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Detail.Segments}" Margin="0,12,0,6" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource Brush.WarningLight}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.WarningText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Archived customer" Foreground="{DynamicResource Brush.Danger}" FontWeight="SemiBold" Visibility="{Binding Detail.IsArchived, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="Phone" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.Profile.Phone, TargetNullValue=—}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="E-mail" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.Profile.Email, TargetNullValue=—}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Birthday" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.Profile.Birthday, TargetNullValue=—}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Address" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.Profile.Address, TargetNullValue=—}" Style="{StaticResource Text.Wrap}" />
                            <TextBlock Text="Preferred staff" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.PreferredStaffName, TargetNullValue=No preference}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Notifications" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Style="{StaticResource Text.Body}"><Run Text="E-mail: " /><Run Text="{Binding Detail.Profile.AllowEmail, Mode=OneWay}" /><Run Text=" · SMS: " /><Run Text="{Binding Detail.Profile.AllowSms, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="Notes" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding Detail.Profile.Notes, TargetNullValue=—}" Style="{StaticResource Text.Wrap}" />
                            <TextBlock Text="Tags" Style="{StaticResource Text.Label}" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding Detail.Profile.Tags}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Border Style="{StaticResource Chip}"><TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Primary}" /></Border></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"><Run Text="Customer since " /><Run Text="{Binding Detail.CreatedAt, StringFormat={}{0:MMMM d, yyyy}, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="Contact details are hidden for your role." Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Visibility="{Binding Detail.ContactHidden, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Stats -->
                <UniformGrid Grid.Row="1" Grid.Column="1" Columns="5" Margin="-6,0,-6,16">
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <StackPanel><TextBlock Text="{Binding Detail.Stats.Completed}" Style="{StaticResource Text.Kpi}" FontSize="24" /><TextBlock Text="Completed visits" Style="{StaticResource Text.Caption}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <StackPanel><TextBlock Text="{Binding Detail.Stats.TotalPaidMinor, Converter={StaticResource Money}}" Style="{StaticResource Text.Kpi}" FontSize="24" /><TextBlock Text="Total paid" Style="{StaticResource Text.Caption}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <StackPanel><TextBlock Text="{Binding Detail.Stats.Upcoming}" Style="{StaticResource Text.Kpi}" FontSize="24" /><TextBlock Text="Upcoming" Style="{StaticResource Text.Caption}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <StackPanel><TextBlock Text="{Binding Detail.Stats.Cancelled}" Style="{StaticResource Text.Kpi}" FontSize="24" /><TextBlock Text="Cancelled" Style="{StaticResource Text.Caption}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                        <StackPanel><TextBlock Text="{Binding Detail.Stats.NoShows}" Style="{StaticResource Text.Kpi}" FontSize="24" /><TextBlock Text="No-shows" Style="{StaticResource Text.Caption}" /></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                    <TabControl>
                        <TabItem Header="Appointments">
                            <DataGrid ItemsSource="{Binding Appointments}" core:ItemActivation.Command="{Binding OpenAppointmentCommand}" MinHeight="260" MaxHeight="560" AutomationProperties.AutomationId="CustomerAppointments">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding Start, StringFormat={}{0:MMM d, yyyy h:mm tt}}" Width="160" />
                                    <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="110" />
                                    <DataGridTextColumn Header="SERVICES" Binding="{Binding Services}" Width="1.5*" />
                                    <DataGridTextColumn Header="STAFF" Binding="{Binding Staff}" Width="*" />
                                    <DataGridTemplateColumn Header="STATUS" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Payments" Visibility="{Binding CanViewPayments, Converter={StaticResource VisibleWhen}}">
                            <DataGrid ItemsSource="{Binding Payments}" core:ItemActivation.Command="{Binding OpenReceiptCommand}" MinHeight="260" MaxHeight="560">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding RecordedAt, StringFormat={}{0:MMM d, yyyy h:mm tt}}" Width="160" />
                                    <DataGridTextColumn Header="RECEIPT" Binding="{Binding ReceiptNumber}" Width="130" />
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="90" />
                                    <DataGridTextColumn Header="METHOD" Binding="{Binding Method, Converter={StaticResource MethodText}}" Width="*" />
                                    <DataGridTextColumn Header="APPOINTMENT" Binding="{Binding AppointmentReference}" Width="120" />
                                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding SignedAmountMinor, Converter={StaticResource Money}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Invoices" Visibility="{Binding CanViewPayments, Converter={StaticResource VisibleWhen}}">
                            <DataGrid ItemsSource="{Binding Invoices}" core:ItemActivation.Command="{Binding OpenInvoiceCommand}" MinHeight="260" MaxHeight="560">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INVOICE" Binding="{Binding Number}" Width="140" />
                                    <DataGridTextColumn Header="ISSUED" Binding="{Binding IssuedAt, StringFormat={}{0:MMM d, yyyy}}" Width="140" />
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status, Converter={StaticResource EnumText}}" Width="*" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <!-- =================================================================== Staff -->
    <DataTemplate DataType="{x:Type p:StaffViewModel}">
        <Grid Margin="{StaticResource Pad.Page}" AutomationProperties.AutomationId="StaffPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Success}" Command="{Binding NewCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}"
                        VerticalAlignment="Center" AutomationProperties.AutomationId="StaffNew">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FA;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Add Staff Member" /></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Staff" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Profiles, qualified services, working schedules, leave and performance." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,16,12">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search staff…" Width="220" Margin="0,0,10,0" />
                <CheckBox Content="Archived" IsChecked="{Binding IncludeArchived}" Style="{StaticResource Toggle}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="StaffList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="10,9">
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=light}">
                                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"><Run Text="{Binding TodayAppointments, Mode=OneWay}" /><Run Text=" today" /></TextBlock>
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.WarningLight}" HorizontalAlignment="Right" Visibility="{Binding OnLeaveToday, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="On leave" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.WarningText}" FontSize="10.5" />
                                    </Border>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Text.Strong}" />
                                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Position, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LocationName, Mode=OneWay, TargetNullValue=Any location}" /></TextBlock>
                                    <TextBlock Text="{Binding WeeklyHours}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}">
                            <Button Style="{StaticResource Button.Secondary}" Content="Edit Profile" Command="{Binding EditCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="StaffEdit" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Archive / Restore" Command="{Binding ToggleArchiveCommand}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28" Margin="0,0,14,0" Background="{Binding Detail.Profile.ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=light}">
                            <TextBlock Text="{Binding Detail.Profile.FullName, Converter={StaticResource Initials}}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Detail.Profile.ColorHex, Converter={StaticResource HexBrush}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Detail.Profile.FullName}" Style="{StaticResource Text.H2}" />
                            <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding Detail.Profile.Position, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail.Profile.EmploymentStatus, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <TabControl SelectedIndex="{Binding Tab}">
                        <TabItem Header="Profile">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,16,12"><TextBlock Text="Phone" Style="{StaticResource Text.Label}" /><TextBlock Text="{Binding Detail.Profile.Phone, TargetNullValue=—}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="E-mail" Style="{StaticResource Text.Label}" /><TextBlock Text="{Binding Detail.Profile.Email, TargetNullValue=—}" /></StackPanel>
                                        <StackPanel Margin="0,0,16,12"><TextBlock Text="Skills" Style="{StaticResource Text.Label}" /><TextBlock Text="{Binding Detail.Profile.SkillsText, TargetNullValue=—}" Style="{StaticResource Text.Wrap}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="Calendar colour" Style="{StaticResource Text.Label}" /><Border Width="40" Height="18" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding Detail.Profile.ColorHex, Converter={StaticResource HexBrush}}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Qualified services" Style="{StaticResource Text.Label}" Margin="0,4,0,8" />
                                    <ItemsControl ItemsSource="{Binding Detail.Services}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Brush.Primary}" /></Border></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No qualified services yet — this person cannot be booked until services are assigned." Style="{StaticResource Text.SecondaryWrap}"
                                               Visibility="{Binding Detail.Services.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    <TextBlock Text="Last 30 days" Style="{StaticResource Text.H3}" Margin="0,18,0,10" />
                                    <UniformGrid Columns="4">
                                        <StackPanel><TextBlock Text="{Binding Detail.Performance30Days.Completed}" Style="{StaticResource Text.H2}" /><TextBlock Text="Completed" Style="{StaticResource Text.Caption}" /></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Detail.Performance30Days.ServiceRevenueMinor, Converter={StaticResource Money}}" Style="{StaticResource Text.H2}" /><TextBlock Text="Service revenue" Style="{StaticResource Text.Caption}" /></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Detail.Performance30Days.Utilization, Converter={StaticResource Percent}}" Style="{StaticResource Text.H2}" /><TextBlock Text="Utilization" Style="{StaticResource Text.Caption}" /></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Detail.Performance30Days.CancellationRate, Converter={StaticResource Percent}}" Style="{StaticResource Text.H2}" /><TextBlock Text="Cancel / no-show" Style="{StaticResource Text.Caption}" /></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Working Schedule" AutomationProperties.AutomationId="StaffScheduleTab">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}">
                                    <Button Style="{StaticResource Button.Primary}" Content="Save Schedule" Command="{Binding SaveScheduleCommand}" AutomationProperties.AutomationId="SaveSchedule" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DAY" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Grid.Column="1" Text="WORKS" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Grid.Column="2" Text="START" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Grid.Column="3" Text="END" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Grid.Column="4" Text="BREAK FROM" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Grid.Column="5" Text="BREAK TO" Style="{StaticResource Text.Overline}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Shifts}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DayName}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Works}" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DayName}" />
                                                    <TextBox Grid.Column="2" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Tag="09:00" IsEnabled="{Binding Works}" />
                                                    <TextBox Grid.Column="3" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Tag="18:00" IsEnabled="{Binding Works}" />
                                                    <TextBox Grid.Column="4" Text="{Binding BreakStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Tag="none" IsEnabled="{Binding Works}" />
                                                    <TextBox Grid.Column="5" Text="{Binding BreakEnd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Tag="none" IsEnabled="{Binding Works}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,10,0,0"
                                               Text="Times use 24-hour HH:mm. Bookings outside these hours are flagged as overtime and need an authorised override; existing bookings outside a new schedule are listed after saving." />
                                </StackPanel>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Time Off">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Margin="0,0,0,10" Command="{Binding AddTimeOffCommand}"
                                        Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AddTimeOff">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Record Leave / Time Off" /></StackPanel>
                                </Button>
                                <Grid>
                                    <DataGrid ItemsSource="{Binding TimeOff}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="100" />
                                            <DataGridTextColumn Header="FROM" Binding="{Binding Start, StringFormat={}{0:ddd MMM d, yyyy h:mm tt}}" Width="*" />
                                            <DataGridTextColumn Header="TO" Binding="{Binding End, StringFormat={}{0:ddd MMM d, yyyy h:mm tt}}" Width="*" />
                                            <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="*" />
                                            <DataGridTemplateColumn Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Button.Link}" Content="Remove" Foreground="{DynamicResource Brush.Danger}"
                                                                Command="{Binding DataContext.RemoveTimeOffCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No leave or time off recorded." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding TimeOff.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Team Performance">
                            <DataGrid ItemsSource="{Binding Performance}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STAFF (THIS MONTH)" Binding="{Binding Name}" Width="1.4*" />
                                    <DataGridTextColumn Header="APPTS" Binding="{Binding Appointments}" Width="70" />
                                    <DataGridTextColumn Header="DONE" Binding="{Binding Completed}" Width="70" />
                                    <DataGridTextColumn Header="SCHEDULED H" Binding="{Binding ScheduledHours}" Width="100" />
                                    <DataGridTextColumn Header="BOOKED H" Binding="{Binding BookedHours}" Width="90" />
                                    <DataGridTextColumn Header="UTILIZATION" Binding="{Binding Utilization, Converter={StaticResource Percent}}" Width="100" />
                                    <DataGridTextColumn Header="CANCEL/NO-SHOW" Binding="{Binding CancellationRate, Converter={StaticResource Percent}}" Width="120" />
                                    <DataGridTextColumn Header="AVG MIN" Binding="{Binding AverageServiceMinutes, StringFormat={}{0:0}}" Width="80" />
                                    <DataGridTextColumn Header="SERVICE REVENUE" Binding="{Binding ServiceRevenueMinor, Converter={StaticResource Money}}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
