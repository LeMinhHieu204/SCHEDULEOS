                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.SecondaryWrap}" Margin="0,0,0,12" AutomationProperties.AutomationId="ConflictSummary" />
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel.Soft}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Button.Link}" Content="Reschedule" Margin="0,0,12,0" Command="{Binding DataContext.RescheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Button.Link}" Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Text.Strong}"><Run Text="#" /><Run Text="{Binding Reference, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Customer, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding When, Mode=OneWay}" /></TextBlock>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource ConflictRowTemplate}" />
