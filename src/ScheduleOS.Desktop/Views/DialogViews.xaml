        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="DocumentPreview">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Close" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" Command="{Binding SavePdfCommand}" AutomationProperties.AutomationId="SavePdf">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Save as PDF" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Print" /></StackPanel>
                    </Button>
                </StackPanel>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Background="White" Height="560">
                    <FlowDocumentScrollViewer Document="{Binding Document}" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
                </Border>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Follow-up -->
    <DataTemplate DataType="{x:Type d:FollowUpViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SecondaryWrap}"><Run Text="Creates an in-app reminder to follow up with " /><Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Date" Style="{StaticResource DlgLabel}" /><DatePicker SelectedDate="{Binding Date}" /></StackPanel>
                    <StackPanel><TextBlock Text="Time (HH:mm)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Note" Style="{StaticResource DlgLabel}" />
                <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MinHeight="56" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Add follow-up" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
