                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Full name *" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" AutomationProperties.AutomationId="CustName" /></StackPanel>
                    <StackPanel><TextBlock Text="Birthday (optional)" Style="{StaticResource DlgLabel}" /><DatePicker SelectedDate="{Binding Birthday}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Phone" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CustPhone" /></StackPanel>
                    <StackPanel><TextBlock Text="E-mail" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CustEmail" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Address (optional)" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Tags (comma separated)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Tag="VIP, Prefers morning, Sensitive skin" /></StackPanel>
                    <StackPanel><TextBlock Text="Preferred staff" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding PreferredStaff}" DisplayMemberPath="Name" /></StackPanel>
