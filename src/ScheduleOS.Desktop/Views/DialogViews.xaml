<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="clr-namespace:ScheduleOS.Desktop.ViewModels.Dialogs"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <Style x:Key="DlgLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Margin" Value="0,12,0,5" />
    </Style>
    <Style x:Key="DlgFooter" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,20,0,0" />
    </Style>
    <Style x:Key="DlgBody" TargetType="Border">
        <Setter Property="Padding" Value="24,4,24,22" />
    </Style>

    <DataTemplate x:Key="ConflictRowTemplate">
        <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningLight}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlocking}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.DangerLight}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,1,10,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocking}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Wrap}" FontSize="12.5" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Confirm -->
    <DataTemplate DataType="{x:Type d:ConfirmDialogViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Wrap}" FontSize="13.5" AutomationProperties.AutomationId="DialogMessage" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" Visibility="{Binding ShowCancel, Converter={StaticResource VisibleWhen}}"
                            AutomationProperties.AutomationId="DialogCancel" />
                    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="100" AutomationProperties.AutomationId="DialogConfirm">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Prompt -->
    <DataTemplate DataType="{x:Type d:PromptDialogViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.SecondaryWrap}" FontSize="13" Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" AutomationProperties.AutomationId="PromptText">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Multiline}" Value="True">
                                    <Setter Property="AcceptsReturn" Value="True" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="MinHeight" Value="72" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="Padding" Value="10,8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="100" AutomationProperties.AutomationId="PromptConfirm" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Conflicts -->
    <DataTemplate DataType="{x:Type d:ConflictDialogViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.SecondaryWrap}" Margin="0,0,0,12" />
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ConflictRowTemplate}" AutomationProperties.AutomationId="ConflictList" />
                </ScrollViewer>
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Go back" Margin="0,0,10,0" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="ConflictBack" />
                    <Button Style="{StaticResource Button.Danger}" Content="Override and save" Command="{Binding OverrideCommand}" Visibility="{Binding CanOverride, Converter={StaticResource VisibleWhen}}"
                            AutomationProperties.AutomationId="ConflictOverride" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ New appointment -->
    <DataTemplate DataType="{x:Type d:AppointmentEditorViewModel}">
        <Grid AutomationProperties.AutomationId="AppointmentEditor">
            <Grid.InputBindings>
                <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
            </Grid.InputBindings>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,16,20">
                <StackPanel>
                    <!-- Customer -->
                    <TextBlock Text="1  Customer" Style="{StaticResource Text.H3}" Margin="0,4,0,8" />
                    <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding NewCustomerCommand}" AutomationProperties.AutomationId="EditorNewCustomer">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FA;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="New" /></StackPanel>
                            </Button>
                            <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Search customers by name, phone or e-mail…" core:FocusAssist.FocusOnLoad="True"
                                     AutomationProperties.AutomationId="EditorCustomerSearch" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" MaxHeight="150">
                            <ListBox ItemsSource="{Binding CustomerResults}" SelectedItem="{Binding Customer}" AutomationProperties.AutomationId="EditorCustomerList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="10,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Panel.Soft}" Margin="0,8,0,0" Visibility="{Binding CustomerDisplay, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding CustomerDisplay}" Style="{StaticResource Text.Strong}" AutomationProperties.AutomationId="EditorSelectedCustomer" />
                        </StackPanel>
                    </Border>

                    <!-- Services -->
                    <DockPanel Margin="0,20,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="+ Add another service" Command="{Binding AddLineCommand}" AutomationProperties.AutomationId="EditorAddService" />
                        <TextBlock Text="2  Services, staff &amp; rooms" Style="{StaticResource Text.H3}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel.Soft}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Service" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding DataContext.Services, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Service}"
                                                      DisplayMemberPath="Name" AutomationProperties.AutomationId="EditorService" />
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Staff" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding Staff}" DisplayMemberPath="Name" AutomationProperties.AutomationId="EditorStaff" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="Room / resource" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding ResourceOptions}" SelectedItem="{Binding Resource}" DisplayMemberPath="Name" IsEnabled="{Binding NeedsResource}"
                                                      AutomationProperties.AutomationId="EditorResource" />
                                            <TextBlock Text="Not required" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" Visibility="{Binding NeedsResource, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Text="Price" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                            <TextBlock Text="Discount" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Tag="0" />
                                        </StackPanel>
                                        <Button Grid.Column="5" Style="{StaticResource Button.Icon}" Content="&#xE74D;" VerticalAlignment="Center" Margin="0,14,0,0" Command="{Binding RemoveCommand}" ToolTip="Remove service"
                                                AutomationProperties.Name="Remove service" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- When -->
                    <DockPanel Margin="0,16,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Find available time…" Command="{Binding FindTimeCommand}" Visibility="{Binding CanEditSchedule, Converter={StaticResource VisibleWhen}}"
                                AutomationProperties.AutomationId="EditorFindTime" />
                        <TextBlock Text="3  Date &amp; time" Style="{StaticResource Text.H3}" />
                    </DockPanel>
                    <Grid IsEnabled="{Binding CanEditSchedule}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Date" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding Date}" AutomationProperties.AutomationId="EditorDate" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Start time" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding Time}" ItemStringFormat="h:mm tt" AutomationProperties.AutomationId="EditorTime" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Status" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" AutomationProperties.AutomationId="EditorStatus" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Booking source" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" />
                        </StackPanel>
                    </Grid>

                    <!-- Notes -->
                    <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="4  Notes &amp; reminders" Style="{StaticResource Text.H3}" Margin="0,20,0,8" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Customer notes" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource TextBox.Multiline}" MinHeight="60" Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}" Tag="Shown on customer documents" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding CanEditInternalNotes, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="Internal notes (staff only)" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource TextBox.Multiline}" MinHeight="60" Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.NotesWarm}" />
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="E-mail reminder" IsChecked="{Binding RemindByEmail}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <CheckBox Content="SMS reminder" IsChecked="{Binding RemindBySms}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <TextBlock Text="hours before:" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Margin="0,0,6,0" />
                            <TextBox Text="{Binding ReminderLeadHours, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource Text.Wrap}" Margin="0,10,0,0" Visibility="{Binding FormError, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Summary -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" CornerRadius="0,0,12,0" Padding="20,4,20,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource Button.Success}" Height="44" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="EditorSave">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Book appointment" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCreate}" Value="False"><Setter Property="Text" Value="Save services" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Ctrl+S to save · Esc to close" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Summary" Style="{StaticResource Text.H3}" Margin="0,0,0,10" />
                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,12" AutomationProperties.AutomationId="EditorAvailability">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.InfoLight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClear}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.SuccessLight}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.WarningLight}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasBlocking}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.DangerLight}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding SummaryIcon}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Text="{Binding SummaryState}" Style="{StaticResource Text.Wrap}" FontWeight="SemiBold" FontSize="12.5" AutomationProperties.AutomationId="EditorAvailabilityText" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ConflictRows}" ItemTemplate="{StaticResource ConflictRowTemplate}" />
                            <ItemsControl ItemsSource="{Binding Timeline}" Margin="0,4,0,8" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Left" Width="64" Style="{StaticResource Text.Caption}" Text="{Binding Start, StringFormat={}{0:h:mm tt}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding ServiceName}" Style="{StaticResource Text.Strong}" FontSize="12.5" />
                                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding StaffName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ResourceName, Mode=OneWay, TargetNullValue=no room}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Text.Strong}" /><TextBlock Text="Total duration" Style="{StaticResource Text.Secondary}" /></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding EndText}" Style="{StaticResource Text.Strong}" /><TextBlock Text="Ends at" Style="{StaticResource Text.Secondary}" /></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, Converter={StaticResource Money}}" /><TextBlock Text="Subtotal" Style="{StaticResource Text.Secondary}" /></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Discount, Converter={StaticResource Money}}" /><TextBlock Text="Discounts" Style="{StaticResource Text.Secondary}" /></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Tax, Converter={StaticResource Money}}" /><TextBlock Text="Tax" Style="{StaticResource Text.Secondary}" /></DockPanel>
                            <DockPanel Margin="0,6,0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Money}}" Style="{StaticResource Text.H2}" AutomationProperties.AutomationId="EditorTotal" /><TextBlock Text="Total" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" /></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Deposit, Converter={StaticResource Money}}" /><TextBlock Text="Deposit required" Style="{StaticResource Text.Secondary}" /></DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================ Reschedule -->
    <DataTemplate DataType="{x:Type d:RescheduleViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="RescheduleDialog">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="#" /><Run Text="{Binding Reference, Mode=OneWay}" /><Run Text=" · currently " /><Run Text="{Binding CurrentText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" /></TextBlock>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="New date" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" /><DatePicker SelectedDate="{Binding Date}" AutomationProperties.AutomationId="RescheduleDate" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="New start time" Style="{StaticResource Text.Caption}" Margin="0,0,0,3" /><ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding Time}" ItemStringFormat="h:mm tt" AutomationProperties.AutomationId="RescheduleTime" /></StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Find available time…" VerticalAlignment="Bottom" Command="{Binding FindTimeCommand}" />
                </Grid>
                <TextBlock Text="Staff and rooms" Style="{StaticResource DlgLabel}" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Segment.ServiceName}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding Staff}" DisplayMemberPath="Name" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding ResourceOptions}" SelectedItem="{Binding Resource}" DisplayMemberPath="Name" IsEnabled="{Binding HasResource}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Reason (optional, recorded in history)" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. customer request" />
                <Border CornerRadius="10" Padding="12,10" Margin="0,14,0,8" Background="{DynamicResource Brush.SurfaceAlt}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding StateIcon}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Text}" />
                        <StackPanel>
                            <TextBlock Text="{Binding State}" Style="{StaticResource Text.Strong}" AutomationProperties.AutomationId="RescheduleState" />
                            <TextBlock Text="{Binding NewRange}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConflictRows}" ItemTemplate="{StaticResource ConflictRowTemplate}" />
                </ScrollViewer>
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save new time" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="RescheduleSave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Find time -->
    <DataTemplate DataType="{x:Type d:FindTimeViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="FindTimeDialog">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Services" Style="{StaticResource Text.Label}" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Height="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Services}" Margin="8" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><CheckBox Content="{Binding Service.Name}" IsChecked="{Binding IsSelected}" Margin="0,3" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Preferred date" Style="{StaticResource DlgLabel}" />
                    <DatePicker SelectedDate="{Binding Date}" />
                    <TextBlock Text="Preferred staff" Style="{StaticResource DlgLabel}" />
                    <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding PreferredStaff}" DisplayMemberPath="Name" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Preferred time" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding PreferredTime, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 14:00" /></StackPanel>
                        <StackPanel><TextBlock Text="Days to search" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </UniformGrid>
                    <Button Style="{StaticResource Button.Primary}" Content="Search" Margin="0,14,0,0" Command="{Binding SearchCommand}" AutomationProperties.AutomationId="FindTimeSearch" />
                </StackPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
                        <Button Style="{StaticResource Button.Secondary}" Content="Close" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="Use selected time" Command="{Binding PickCommand}" CommandParameter="{x:Null}" AutomationProperties.AutomationId="FindTimeUse" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" MinHeight="300">
                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" core:ItemActivation.Command="{Binding PickCommand}" AutomationProperties.AutomationId="FindTimeResults">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,8">
                                        <StackPanel DockPanel.Dock="Left" Width="130">
                                            <TextBlock Text="{Binding Start, StringFormat={}{0:ddd, MMM d}}" Style="{StaticResource Text.Strong}" />
                                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Start, StringFormat={}{0:h:mm tt}, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding End, StringFormat={}{0:h:mm tt}, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StaffSummary}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding ResourceSummary}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Conflict report -->
    <DataTemplate DataType="{x:Type d:ConflictReportViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="ConflictReport">
