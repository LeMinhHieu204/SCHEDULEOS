                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save customer" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="CustSave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Staff editor -->
    <DataTemplate DataType="{x:Type d:StaffEditorViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="StaffEditor">
            <Border.InputBindings><KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" /></Border.InputBindings>
            <StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Full name *" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" AutomationProperties.AutomationId="StaffName" /></StackPanel>
                    <StackPanel><TextBlock Text="Position *" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Massage Therapist" AutomationProperties.AutomationId="StaffPosition" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Phone" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="E-mail" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Employment status" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" /></StackPanel>
                    <StackPanel><TextBlock Text="Location" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding Location}" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Skills / notes" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding SkillsText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Deep tissue, sports therapy" />
                <TextBlock Text="Calendar colour" Style="{StaticResource DlgLabel}" />
                <ItemsControl ItemsSource="{Binding Colors}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="28" Height="28" MinHeight="0" Padding="0" Margin="0,0,8,0" Style="{StaticResource Button.Ghost}" Background="{Binding Converter={StaticResource HexBrush}}"
                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Selected:" Style="{StaticResource Text.Secondary}" Margin="0,0,8,0" />
                    <Border Width="40" Height="16" CornerRadius="4" Background="{Binding Color, Converter={StaticResource HexBrush}}" />
                </StackPanel>
                <TextBlock Text="Qualified services (the staff member can only be booked for these)" Style="{StaticResource DlgLabel}" />
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Height="170">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServiceOptions}" Margin="10,6" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,3" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="New staff members start with a Mon–Fri 09:00–18:00 schedule (break 12:00–13:00). Adjust it under Staff → Working Schedule."
                           Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save staff member" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="StaffSave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Service editor -->
    <DataTemplate DataType="{x:Type d:ServiceEditorViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="ServiceEditor">
            <Border.InputBindings><KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" /></Border.InputBindings>
            <StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Service name *" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" AutomationProperties.AutomationId="SvcName" /></StackPanel>
                    <StackPanel>
                        <TextBlock Text="Category" Style="{StaticResource DlgLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="New" Margin="6,0,0,0" Command="{Binding NewCategoryCommand}" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" />
                        </DockPanel>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="Description" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                <UniformGrid Columns="5">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Duration (min)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SvcDuration" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Prep (min)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Prep, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Cleanup (min)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Cleanup, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Price *" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SvcPrice" /></StackPanel>
                    <StackPanel><TextBlock Text="Deposit" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Deposit, UpdateSourceTrigger=PropertyChanged}" Tag="0" /></StackPanel>
                </UniformGrid>
                <CheckBox Content="Active (bookable)" IsChecked="{Binding IsActive}" Style="{StaticResource Toggle}" Margin="0,14,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Requires one of these rooms / resources" Style="{StaticResource DlgLabel}" />
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ItemsControl ItemsSource="{Binding ResourceOptions}" Focusable="False">
                                <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Qualified staff" Style="{StaticResource DlgLabel}" />
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Height="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StaffOptions}" Margin="10,6" Focusable="False">
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Changing a price or duration affects new bookings only; existing appointments keep their agreed values." Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save service" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SvcSave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Resource editor -->
    <DataTemplate DataType="{x:Type d:ResourceEditorViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="ResourceEditor">
            <Border.InputBindings><KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" /></Border.InputBindings>
            <StackPanel>
                <TextBlock Text="Name *" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" AutomationProperties.AutomationId="ResName" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Type" Style="{StaticResource DlgLabel}" />
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" AutomationProperties.AutomationId="ResType">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ResourceTypeText}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel><TextBlock Text="Location" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding Location}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Capacity (simultaneous bookings)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Status" Style="{StaticResource DlgLabel}" /><CheckBox Content="Available for booking" IsChecked="{Binding IsActive}" Style="{StaticResource Toggle}" Margin="0,8,0,0" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Available from (optional, HH:mm)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding AvailableFrom, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Available until (optional, HH:mm)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding AvailableUntil, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Notes" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save resource" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="ResSave" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Change password -->
    <DataTemplate DataType="{x:Type d:ChangePasswordDialogViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="Current password" Style="{StaticResource DlgLabel}" />
                <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding Current, Mode=TwoWay}" core:FocusAssist.FocusOnLoad="True" />
                <TextBlock Text="New password" Style="{StaticResource DlgLabel}" />
                <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding New, Mode=TwoWay}" />
                <TextBlock Text="Confirm new password" Style="{StaticResource DlgLabel}" />
                <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding Confirm, Mode=TwoWay}" />
                <TextBlock Text="At least 8 characters with letters and numbers." Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Change password" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ User editor -->
    <DataTemplate DataType="{x:Type d:UserEditorViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="Username" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsNew, Converter={StaticResource Not}}" core:FocusAssist.FocusOnLoad="True" />
                <TextBlock Text="Display name" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Role" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" /></StackPanel>
                    <StackPanel><TextBlock Text="Linked staff profile" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding StaffMember}" DisplayMemberPath="Name" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding RoleDescription}" Style="{StaticResource Text.SecondaryWrap}" Margin="0,8,0,0" />
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Initial password" Style="{StaticResource DlgLabel}" />
                    <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Content="Account active" IsChecked="{Binding IsActive}" Style="{StaticResource Toggle}" Margin="0,12,0,0" Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Save account" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Date range -->
    <DataTemplate DataType="{x:Type d:DateRangeDialogViewModel}">
        <Border Style="{StaticResource DlgBody}">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.SecondaryWrap}" />
                <StackPanel Visibility="{Binding HasKinds, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Type" Style="{StaticResource DlgLabel}" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
                </StackPanel>
                <CheckBox Content="All day" IsChecked="{Binding AllDay}" Style="{StaticResource Toggle}" Margin="0,14,0,0" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="From" Style="{StaticResource DlgLabel}" /><DatePicker SelectedDate="{Binding StartDate}" /></StackPanel>
                    <StackPanel><TextBlock Text="To" Style="{StaticResource DlgLabel}" /><DatePicker SelectedDate="{Binding EndDate}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0" Visibility="{Binding AllDay, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"><TextBlock Text="Start time (HH:mm)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Visibility="{Binding AllDay, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"><TextBlock Text="End time (HH:mm)" Style="{StaticResource DlgLabel}" /><TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Reason" Style="{StaticResource DlgLabel}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Style="{StaticResource DlgFooter}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================================================================ Record payment -->
    <DataTemplate DataType="{x:Type d:RecordPaymentViewModel}">
        <Border Style="{StaticResource DlgBody}" AutomationProperties.AutomationId="RecordPaymentDialog">
            <StackPanel>
                <StackPanel Visibility="{Binding FixedAppointment, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Text="Appointment" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search reference or customer…" core:FocusAssist.FocusOnLoad="True" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Height="160" Margin="0,6,0,0">
                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Appointment}" AutomationProperties.AutomationId="PayCandidates">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="10,6">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"><Run Text="due " /><Run Text="{Binding TotalMinor, Converter={StaticResource Money}, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="{Binding Reference, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CustomerName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Start, StringFormat={}{0:MMM d}, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" /></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource Panel.Soft}" Margin="0,10,0,0" Visibility="{Binding Appointment, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="Balance due" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Balance, Converter={StaticResource Money}}" Style="{StaticResource Text.H2}" HorizontalAlignment="Right" AutomationProperties.AutomationId="PayBalance" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Strong}"><Run Text="#" /><Run Text="{Binding Appointment.Reference, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Appointment.CustomerName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding Appointment.Services}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Type" Style="{StaticResource DlgLabel}" /><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Method" Style="{StaticResource DlgLabel}" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" AutomationProperties.AutomationId="PayMethod">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource MethodText}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Amount" Style="{StaticResource DlgLabel}" />
