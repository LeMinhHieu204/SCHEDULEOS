<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ScheduleOS.Desktop.ViewModels"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <!-- Brand panel shared by onboarding and login -->
    <DataTemplate x:Key="BrandPanel">
        <Border Background="{DynamicResource Brush.Sidebar}">
            <Grid Margin="56,48">
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/ScheduleOS;component/Assets/logo-256.png" Width="46" Height="46" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="Bold" Foreground="White">
                            <Run Text="Schedule" /><Run Text="OS" Foreground="{DynamicResource Brush.PrimaryBright}" />
                        </TextBlock>
                        <TextBlock Text="Smart Appointment Manager" FontSize="12" Foreground="{DynamicResource Brush.SidebarTextMuted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Every Appointment." FontFamily="{StaticResource Font.Display}" FontSize="34" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Perfectly Organized." FontFamily="{StaticResource Font.Display}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Brush.PrimaryBright}" />
                    <TextBlock Text="Scheduling, customers, staff, rooms, payments and reports for spas, salons, barbers and wellness studios — fully offline on this PC."
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.SidebarText}" FontSize="14" Margin="0,18,0,26" MaxWidth="420" HorizontalAlignment="Left" />
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#2200B8BD">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryBright}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.SidebarText}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Items>
                            <x:Static Member="vm:BrandText.Feature1" />
                            <x:Static Member="vm:BrandText.Feature2" />
                            <x:Static Member="vm:BrandText.Feature3" />
                            <x:Static Member="vm:BrandText.Feature4" />
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="Your data stays on this computer (SQLite). Back it up from Settings → Data." VerticalAlignment="Bottom" FontSize="11.5"
                           Foreground="{DynamicResource Brush.SidebarTextMuted}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- =================================================================== Login -->
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <Grid Background="{DynamicResource Brush.Workspace}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource BrandPanel}" Focusable="False" />
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32"
                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="LoginCard">
                <StackPanel>
                    <TextBlock Text="Sign in" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding BusinessName}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8" />
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.WarningLight}" Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                        <TextBlock Text="Demo workspace · fictional data" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.WarningText}" />
                    </Border>
                    <Border Background="{DynamicResource Brush.InfoLight}" CornerRadius="8" Padding="12,9" Margin="0,8,0,0" Visibility="{Binding Info, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource Brush.Info}" FontSize="12.5" />
                    </Border>
                    <TextBlock Text="Username" Style="{StaticResource Text.Label}" Margin="0,18,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" core:FocusAssist.FocusOnLoad="True" Tag="Your username"
                             AutomationProperties.AutomationId="LoginUsername" AutomationProperties.Name="Username" />
                    <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                    <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" AutomationProperties.AutomationId="LoginPassword" AutomationProperties.Name="Password">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0" FontSize="12.5"
                               Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="LoginError" />
                    <Button Content="Sign in" Style="{StaticResource Button.Primary}" Height="42" Margin="0,22,0,0" Command="{Binding SignInCommand}" IsDefault="True"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.AutomationId="LoginButton" />
                    <TextBlock Text="Accounts are created by the Owner in Settings → Users &amp; Roles. Five failed attempts lock the account for a few minutes."
                               Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Onboarding -->
    <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
        <Grid Background="{DynamicResource Brush.Workspace}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource BrandPanel}" Focusable="False" />
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30"
                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="OnboardingCard">
                <StackPanel>
                    <TextBlock Text="Welcome to ScheduleOS" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Let's set up your workspace. This takes about a minute." Style="{StaticResource Text.Secondary}" Margin="0,4,0,18" />
                    <TextBlock Style="{StaticResource Text.Overline}" Margin="0,0,0,14">
                        <Run Text="STEP " /><Run Text="{Binding Step, Mode=OneWay}" /><Run Text=" OF 3" />
                    </TextBlock>

                    <!-- Step 1 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Your business" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />
                        <TextBlock Text="Business name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Serenity Spa &amp; Salon" core:FocusAssist.FocusOnLoad="True"
                                 AutomationProperties.AutomationId="OnbBusinessName" />
                        <TextBlock Text="Currency" Style="{StaticResource Text.Label}" Margin="0,14,0,5" />
                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" AutomationProperties.AutomationId="OnbCurrency" />
                        <TextBlock Text="Money is stored in exact minor units. The currency's decimal places cannot be changed once payments exist."
                                   Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Owner account" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />
                        <TextBlock Text="Your name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Tag="Full name" AutomationProperties.AutomationId="OnbOwnerName" />
                        <TextBlock Text="Username" Style="{StaticResource Text.Label}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Tag="Used to sign in" AutomationProperties.AutomationId="OnbUsername" />
                        <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,12,0,5" />
                        <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" AutomationProperties.AutomationId="OnbPassword" />
                        <TextBlock Text="Confirm password" Style="{StaticResource Text.Label}" Margin="0,12,0,5" />
                        <PasswordBox core:PasswordBoxAssist.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" AutomationProperties.AutomationId="OnbConfirm" />
                        <TextBlock Text="At least 8 characters with letters and numbers. Common or default passwords are rejected. The password is stored as a salted PBKDF2 hash."
                                   Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="How do you want to start?" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Panel.Soft}" Margin="0,0,0,10">
                            <RadioButton GroupName="Start" IsChecked="{Binding CreateEmpty}" AutomationProperties.AutomationId="OnbEmpty">
                                <StackPanel>
                                    <TextBlock Text="Empty production workspace" Style="{StaticResource Text.Strong}" />
                                    <TextBlock Text="Start clean and add your own services, staff, rooms and customers." Style="{StaticResource Text.SecondaryWrap}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border Style="{StaticResource Panel.Soft}">
                            <RadioButton GroupName="Start" IsChecked="{Binding CreateDemo}" AutomationProperties.AutomationId="OnbDemo">
                                <StackPanel>
                                    <TextBlock Text="Demo workspace" Style="{StaticResource Text.Strong}" />
                                    <TextBlock Text="2 locations, 8 staff, 25 services, 10 rooms, 50 fictional customers and several weeks of appointments relative to today. Clearly labelled; can be reset later."
                                               Style="{StaticResource Text.SecondaryWrap}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource Brush.Danger}" Margin="0,14,0,0" FontSize="12.5"
                               Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="OnbError" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Progress, Converter={StaticResource VisibleWhen}}">
                        <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,22,0,0">
                        <Button Content="Back" HorizontalAlignment="Left" Command="{Binding BackCommand}" Width="96" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Step}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Continue" Width="130" Command="{Binding NextCommand}" AutomationProperties.AutomationId="OnbNext">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Create workspace" Command="{Binding FinishCommand}" Width="170" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                    AutomationProperties.AutomationId="OnbFinish">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Lock screen -->
    <DataTemplate DataType="{x:Type vm:LockViewModel}">
        <Grid Background="{DynamicResource Brush.Sidebar}" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Style="{StaticResource Card}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28" AutomationProperties.AutomationId="LockCard">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.PrimaryLight}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Primary}" />
                    </Border>
                    <TextBlock Text="Session locked" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="Enter the password for" /> <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <PasswordBox Margin="0,18,0,0" core:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" core:FocusAssist.FocusOnLoad="True">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding UnlockCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" FontSize="12.5" Margin="0,8,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                    <Button Content="Unlock" Style="{StaticResource Button.Primary}" Margin="0,16,0,0" Height="40" Command="{Binding UnlockCommand}" />
                    <Button Content="Sign out instead" Style="{StaticResource Button.Link}" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding SignOutCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
