<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:ScheduleOS.Desktop.ViewModels.Pages"
                    xmlns:core="clr-namespace:ScheduleOS.Desktop.Core">

    <!-- =================================================================== Services -->
    <DataTemplate DataType="{x:Type p:ServicesViewModel}">
        <Grid Margin="{StaticResource Pad.Page}" AutomationProperties.AutomationId="ServicesPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Success}" Command="{Binding NewCommand}" VerticalAlignment="Center"
                        Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="ServicesNew">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Add Service" /></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Services" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Your service catalog: durations, buffers, prices, deposits, qualified staff and required rooms." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <WrapPanel Grid.Row="1" Margin="0,0,16,12">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search services…" Width="260" Margin="0,0,10,0" AutomationProperties.AutomationId="ServiceSearch" />
                <ComboBox ItemsSource="{Binding CategoryFilter}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" Width="200" Margin="0,0,14,0" />
                <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" Style="{StaticResource Toggle}" VerticalAlignment="Center" />
            </WrapPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" core:ItemActivation.Command="{Binding EditCommand}" AutomationProperties.AutomationId="ServicesGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SERVICE" Width="1.8*" MinWidth="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="6" Height="30" CornerRadius="3" Margin="0,0,10,0" Background="{Binding CategoryColor, Converter={StaticResource HexBrush}}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Strong}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CategoryName, TargetNullValue=Uncategorised}" Style="{StaticResource Text.Caption}" />
                                                    <TextBlock Text=" · archived" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding IsArchived, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DURATION" Binding="{Binding DurationMinutes, StringFormat={}{0} min}" Width="85" />
                            <DataGridTemplateColumn Header="PREP / CLEANUP" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding PrepMinutes, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CleanupMinutes, Mode=OneWay}" /><Run Text=" min" /></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PRICE" Binding="{Binding PriceMinor, Converter={StaticResource Money}}" Width="95" />
                            <DataGridTextColumn Header="DEPOSIT" Binding="{Binding DepositMinor, Converter={StaticResource Money}}" Width="90" />
                            <DataGridTextColumn Header="REQUIRES" Binding="{Binding RequiredResources}" Width="1.2*" />
                            <DataGridTextColumn Header="STAFF" Binding="{Binding StaffCount}" Width="60" />
                            <DataGridTextColumn Header="30-DAY BOOKINGS" Binding="{Binding BookingsLast30Days}" Width="120" />
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessLight}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.NeutralLight}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Inactive" /><Setter Property="Foreground" Value="{DynamicResource Brush.Neutral}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource VisibleWhen}}">
                                            <Button Style="{StaticResource Button.Link}" Content="Edit" Margin="0,0,12,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Link}" Content="Archive/Restore" Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No services yet. Add your first service to start booking." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="+ New" Command="{Binding NewCategoryCommand}" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="Categories" Style="{StaticResource Text.H3}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource VisibleWhen}}">
                                        <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" FontSize="11" Content="&#xE70F;" ToolTip="Rename"
                                                Command="{Binding DataContext.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" FontSize="11" Content="&#xE74D;" ToolTip="Delete (empty categories only)"
                                                Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ServiceCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.SecondaryWrap}" FontSize="11.5" Margin="0,14,0,0"
                               Text="Archiving a service hides it from booking. Existing appointments keep the service name, duration and price that were agreed." />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Resources -->
    <DataTemplate DataType="{x:Type p:ResourcesViewModel}">
        <Grid Margin="{StaticResource Pad.Page}" AutomationProperties.AutomationId="ResourcesPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Success}" Command="{Binding NewCommand}" VerticalAlignment="Center"
                        Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="ResourcesNew">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Add Room / Resource" /></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Rooms &amp; Resources" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Treatment rooms, stations and equipment. Bookings never double-book a room beyond its capacity." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,16,12">
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SuccessLight}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.Success}"><Run Text="{Binding AvailableCount, Mode=OneWay}" /><Run Text=" available now" /></TextBlock>
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.WarningLight}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.WarningText}"><Run Text="{Binding InUseCount, Mode=OneWay}" /><Run Text=" in use" /></TextBlock>
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.DangerLight}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.Danger}"><Run Text="{Binding UnavailableCount, Mode=OneWay}" /><Run Text=" unavailable" /></TextBlock>
                </Border>
                <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" Style="{StaticResource Toggle}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" core:ItemActivation.Command="{Binding EditCommand}" AutomationProperties.AutomationId="ResourcesGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="RESOURCE" Width="1.6*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,10,0" Background="{DynamicResource Brush.InfoLight}">
                                                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Info}" FontSize="13" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Strong}" />
                                                <TextBlock Text="{Binding TypeName}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding LocationName, TargetNullValue=Any}" Width="*" />
                            <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="80" />
                            <DataGridTemplateColumn Header="NOW" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource ResourceStateBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NEXT" Binding="{Binding NextBooking}" Width="120" />
                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource VisibleWhen}}">
                                            <Button Style="{StaticResource Button.Link}" Content="Edit" Margin="0,0,8,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Link}" Content="Block period" Margin="0,0,10,0" Command="{Binding DataContext.ScheduleMaintenanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Link}" Content="Archive" Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No rooms or resources yet." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Maintenance &amp; Blocks" Style="{StaticResource Text.H3}" Margin="0,0,0,4" />
                    <TextBlock Text="Periods when a resource cannot be booked (last 30 days and upcoming)." Style="{StaticResource Text.SecondaryWrap}" Margin="0,0,0,10" />
                    <TextBlock Text="No maintenance scheduled." Style="{StaticResource Text.Secondary}" Visibility="{Binding Maintenance.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Maintenance}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Remove" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveMaintenanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource VisibleWhen}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding ResourceName}" Style="{StaticResource Text.Strong}" />
                                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Start, StringFormat={}{0:MMM d h:mm tt}, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding End, StringFormat={}{0:MMM d h:mm tt}, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
